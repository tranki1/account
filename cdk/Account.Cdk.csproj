<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Account.Cdk</RootNamespace>
    <!-- CDK synthesizes from the compiled assembly; keep it out of the app build. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" Version="2.271.0" />
    <PackageReference Include="Constructs" Version="10.5.0" />
  </ItemGroup>

</Project>
